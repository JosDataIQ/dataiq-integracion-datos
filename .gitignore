.env.*
*credentials*
*secrets*
*api_key*
*apikey*
config/local_*
*.pem
*.key
*.pfx

# Conexiones y configs de plataformas
connection*.properties
*.jks
*.keystore

# ===== Talend Studio =====
*.log
.Rhistory
.metadata/
*.lck
workspace/.metadata/

